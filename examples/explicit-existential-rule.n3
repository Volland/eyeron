# Explicitly scoped variables and an existential rule conclusion.
@prefix : <http://example.org/>.

@forAll :x.
{ :x a :Human } => { @forSome :y. :x :hasMother :y }.
:tom a :Human.
# Derives :tom :hasMother _:witness.

# Substituting :tom for the free variable preserves the local existential.
:universalRule :graph {
    { :x a :Human } => { @forSome :y. :x :hasMother :y }.
}.
:instantiatedRule :graph {
    { :tom a :Human } => { @forSome :y. :tom :hasMother :y }.
}.
