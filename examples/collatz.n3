# collatz. Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Source: https://eyereasoner.github.io/eye/reasoning/collatz/collatz.n3
# Conditional execution is split into even/odd rules; each sequence ends at 1.

@prefix : <http://example.org/>.
@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.

{ 1 :collatz (1) } <= true.
{ ?N :collatz ?Sequence } <= {
    ?N math:greaterThan 1. (?N 2) math:remainder ?Parity. ?Parity math:equalTo 0.
    (?N 2) math:integerQuotient ?Next. ?Next :collatz ?Tail.
    ?Sequence list:firstRest (?N ?Tail).
}.
{ ?N :collatz ?Sequence } <= {
    ?N math:greaterThan 1. (?N 2) math:remainder ?Parity. ?Parity math:equalTo 1.
    (3 ?N) math:product ?Triple. (?Triple 1) math:sum ?Next.
    ?Next :collatz ?Tail. ?Sequence list:firstRest (?N ?Tail).
}.
{ (1 2 3 4 5 6 8 10 16) list:member ?N. ?N :collatz ?Sequence }
    => { :sequences :collatz (?N ?Sequence) }.
