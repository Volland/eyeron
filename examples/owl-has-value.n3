# owl-has-value: a small runnable case for EYE RPO rules.
# Source: https://eyereasoner.github.io/eye/reasoning/rpo/owl-hasValue.n3
# Rules: MIT, Jos De Roo; sample data added for this example.

@prefix : <http://example.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.

# Sample data
:Belgian owl:onProperty :citizenship; owl:hasValue :Belgium. :alice a :Belgian. :bob :citizenship :Belgium.

# Inference rules
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

{?C owl:hasValue ?V. ?C owl:onProperty ?P. ?U a ?C} => {?U ?P ?V}.
{?C owl:hasValue ?V. ?C owl:onProperty ?P. ?U ?P ?V} => {?U a ?C}.
{?C owl:hasValue ?V. ?C owl:onProperty ?P. ?D owl:hasValue ?V. ?D owl:onProperty ?Q. ?P rdfs:subPropertyOf ?Q} => {?C rdfs:subClassOf ?D}.
{?C owl:hasValue ?V. ?C owl:onProperty ?P. ?X ?P ?Y. ?X a ?C. ?V owl:differentFrom ?Y} => false.
