# Quoted conjunctions, local blank nodes, and unquoting.
@prefix : <http://example.org/>.

:alice :likes :pasta.
:bob :says { :alice :likes :pizza, :pasta }.
:bob :says { _:x :likes :pizza. _:x :likes :pasta }.
{ ?x :likes :pasta } => { ?x :likes :spaghetti }.
{ :bob :says ?x } => ?x.

# Applying the unquoting rule yields Alice's likes for pasta and pizza.
# This is the corresponding instantiated implication.
{ :bob :says { :alice :likes :pasta, :pizza } }
    => { :alice :likes :pasta, :pizza }.
