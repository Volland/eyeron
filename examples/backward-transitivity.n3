# Following candidate comparisons
#
# Candidate comparisons can come from scores, awards, or existing links.
# Backward N3 rules extend these comparisons transitively and make the
# resulting answers available to the query.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b1 log:table :moreInterestingThan .
:A :score 8 .
:B :score 5 .
:B :moreInterestingThan :C .
:D :hasAward true .
:B :boring true .

{
    ?X :moreInterestingThan ?Y .
} <= {
    ?X :score ?SX .
    ?Y :score ?SY .
    ?SX math:greaterThan ?SY .
} .

{
    ?X :moreInterestingThan ?Y .
} <= {
    ?X :hasAward true .
    ?Y :boring true .
} .

{
    ?X :moreInterestingThan ?Z .
} <= {
    ?X :moreInterestingThan ?Y .
    ?Y :moreInterestingThan ?Z .
} .

{
    :A :moreInterestingThan :C .
} => {
    :A :moreInterestingThan :C .
} .

{
    :A :moreInterestingThan :C .
} log:query {
    :A :moreInterestingThan :C .
} .
