# Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Source: https://eyereasoner.github.io/eye/reasoning/h2o/
# Standalone program; EYE answer directives use log:query.

# Source file: h2o/hypothesis-001.n3
@base <https://eyereasoner.github.io/eye/reasoning/h2o/hypothesis-001.n3>.
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#>.
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#>.

h:traveler1 h:inOneOf (t:Antwerp-Belgium t:Boston-USA t:Cambridge-USA t:Ghent-Belgium t:Ostend-Belgium).


# Source file: h2o/data-001.n3
@base <https://eyereasoner.github.io/eye/reasoning/h2o/data-001.n3>.
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#>.

t:Antwerp-Belgium t:position-tensor (51.2192 4.4029).
t:Boston-USA t:position-tensor (42.3584 -71.0598).
t:Bruges-Belgium t:position-tensor (51.2108 3.2249).
t:Cambridge-USA t:position-tensor (42.3736 -71.1097).
t:Chicago-USA t:position-tensor (41.8781 -87.6298).
t:Ghent-Belgium t:position-tensor (51.0535 3.7304).
t:Ostend-Belgium t:position-tensor (51.2154 2.9286).


# Source file: h2o/rules-001.n3
@base <https://eyereasoner.github.io/eye/reasoning/h2o/rules-001.n3>.
@prefix list: <http://www.w3.org/2000/10/swap/list#>.
@prefix t: <https://eyereasoner.github.io/eye/reasoning/tfcontext#>.
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#>.

{
    ?T h:inOneOf ?LIST.
    ?C list:in ?LIST.
    ?C t:position-tensor (?LA ?LO).
}
=>
{
    ?T h:location (?LA ?LO).
}.


# Query: h2o/query-001.n3
@prefix h: <https://eyereasoner.github.io/eye/reasoning/h2o#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{
    h:traveler1 h:location (51.0535 3.7304) .
} log:query {
    h:traveler1 h:location (51.0535 3.7304) .
} .

