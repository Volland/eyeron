# Inferring types for small expression terms
#
# Expressions and environments are represented with nested lists. Backward
# N3 rules look up variables and propagate type relationships to derive
# types for the supplied concrete examples.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/type-inference#> .

{
    (?name ?env) :lookup ?type
} <= {
    ?env list:firstRest ((?name ?type) ?_) .
} .

{
    (?name ?env) :lookup ?type
} <= {
    ?env list:firstRest (?first ?rest) .
    ?first list:firstRest (?other ?_) .
    ?name log:notEqualTo ?other .
    (?name ?rest) :lookup ?type .
} .

{
    (?env (:intLit ?n)) :typeOf :int
} <= true .

{
    (?env (:var ?name)) :typeOf ?type
} <= {
    (?name ?env) :lookup ?type
} .

{
    (?env (:lam ?name ?body)) :typeOf (:fun ?arg ?result)
} <= {
    ?newEnv list:firstRest ((?name ?arg) ?env) .
    (?newEnv ?body) :typeOf ?result .
} .

{
    (?env (:app ?fn ?arg)) :typeOf ?result
} <= {
    (?env ?fn) :typeOf (:fun ?input ?result) .
    (?env ?arg) :typeOf ?input .
} .

{
    (() (:app (:lam :x (:var :x)) (:intLit 42))) :typeOf ?t
} => {
    :query :type ?t
} .
