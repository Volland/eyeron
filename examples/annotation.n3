# Reading statement annotations
#
# A statement is associated with its author and recording date. The example
# combines N3 facts with companion RDF input. A query returns the statement
# and its annotation metadata as N3.

@prefix : <https://eyereasoner.github.io/eyeling/examples/annotation#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:a :name "Alice" .
:t log:nameOf {
    :a :name "Alice" .
} .

:t :statedBy :bob .
:t :recorded "2021-07-07"^^xsd:date .

# Query answer
{
    :t log:nameOf ?Statement ;
        :statedBy ?Author ;
        :recorded ?Date .
} log:query {
    :t log:nameOf ?Statement ;
        :statedBy ?Author ;
        :recorded ?Date .
} .
