# Generating reflexive rules in separate steps
#
# A property is marked reflexive. Two N3 rules separately generate backward
# rules for self-links at either end of an existing relation, illustrating
# rules produced as conclusions.

@base <https://eyereasoner.github.io/eye/reasoning/issue141/test3.n3> .
@prefix : <http://www.example.com/ns/ex#> .

{
    ?p a :Reflexive
} => {
    {
        ?x ?p ?x
    } <= {
        ?x ?p ?y
    } .
} .

{
    ?p a :Reflexive
} => {
    {
        ?y ?p ?y
    } <= {
        ?x ?p ?y
    } .
} .

:p a :Reflexive .
