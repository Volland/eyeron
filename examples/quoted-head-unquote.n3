# Activating a quoted rule
#
# A fact stores a graph containing a cat-to-animal rule. An N3 rule uses
# that graph value directly as its conclusion, allowing the stored rule to
# classify the sample cat.

@prefix : <http://example.org/ns#> .

:a :b {
    {
        ?X a :Cat
    } => {
        ?X a :Animal
    } .
} .

{
    :a :b ?C .
} => ?C .

:c a :Cat .

{
    :c a :Animal
} => {
    :test :is true
} .
