# Following the evidence in an N3 proof
#
# A companion proof records how Socrates' mortality was derived. N3 rules
# follow proof dependencies, identify supporting source facts, and inspect
# the bindings used by rule applications.

@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix pa: <http://example.org/proof-audit#> .

{
    ?step pe:uses ?dep
} => {
    ?step pa:dependsOn ?dep
} .

{
    ?a pa:dependsOn ?b .
    ?b pa:dependsOn ?c
} => {
    ?a pa:dependsOn ?c
} .

{
    ?step pe:fact ?src
} => {
    ?step pa:sourceFact true
} .

{
    ?step pa:sourceFact true
} => {
    ?step pa:supportedBy ?step
} .

{
    ?step pa:dependsOn ?anc .
    ?anc pa:sourceFact true
} => {
    ?step pa:supportedBy ?anc
} .

{
    ?root pe:rule ?ruleName
} => {
    pa:test pa:root ?root
} .

{
    pa:test pa:root ?root .
    ?root pa:dependsOn ?anc
} => {
    pa:test pa:queryDependency ?anc
} .

{
    pa:test pa:root ?root .
    ?root pa:supportedBy ?fact
} => {
    pa:test pa:support ?fact
} .

{
    ?root pe:binding ?bindingNode .
    ?bindingNode pe:var ?name .
    ?bindingNode pe:value ?value .
    pa:test pa:root ?root .
} => {
    pa:test pa:answerApplied (?name ?value)
} .
