# Quoted IRIs change only through an explicit substitution rule.
@prefix : <http://example.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

:superman owl:sameAs :clarkKent.
:loisLane :knows { :superman :can :fly }.

# Explicitly transfer the statement about Superman to Clark Kent.
{ ?x owl:sameAs ?y. ?s ?p { ?x ?q ?r } }
    => { ?s ?p { ?y ?q ?r } }.
