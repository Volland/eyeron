# Reading a contact and a member list
#
# Alice knows an unnamed contact, and a team has an ordered member list. N3
# rules follow the contact's properties and split the list to derive the
# contact name and first member.

@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <http://example/> .

:alice :knows [ :name "Bob" ; :tag "friend" ] .
:team :members (:alice :bob :carol) .

{
    ?person :knows ?node .
    ?node :name ?name
} => {
    ?person :knowsNamed ?name
} .

{
    :team :members ?members .
    ?members list:firstRest (?first ?rest)
} => {
    :team :firstMember ?first
} .
