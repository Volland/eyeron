# Comparing two quoted rule sets
#
# A base theory and a candidate theory are stored as quoted graphs. N3
# rules inspect forward and backward implications and report missing rules
# or changed conclusions.

@prefix : <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

<> :base {
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?P :parentOf ?Q .
    } => {
        ?Q :childOf ?P .
    } .

    {
        ?P :worksFor ?Org .
    } <= {
        ?Org :employs ?P .
    } .
} .

<> :candidate {
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?Org :employs ?P .
    } => {
        ?P :worksFor ?Org .
    } .

    {
        ?P :mentors ?Q .
    } => {
        ?Q :menteeOf ?P .
    } .
} .

# Missing in candidate
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Base log:includes {
        ?B log:implies ?H
    } .
    ?Cand log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :missingForwardRule ?H .
} .

{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Base log:includes {
        ?H log:impliedBy ?B
    } .
    ?Cand log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :missingBackwardRule ?H .
} .

# Extra in candidate
{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Cand log:includes {
        ?B log:implies ?H
    } .
    ?Base log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :extraForwardRule ?H .
} .

{
    ?W :base ?Base .
    ?W :candidate ?Cand .
    ?Cand log:includes {
        ?H log:impliedBy ?B
    } .
    ?Base log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :extraBackwardRule ?H .
} .
