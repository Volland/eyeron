# task-completion. Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Source: https://eyereasoner.github.io/eye/reasoning/n3c/forAllIn_query.n3
# The subtasks document is embedded; no network fetch is needed.

@prefix : <http://example.org/test#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.

:task1 a :CompositeTask.

:task2 a :CompositeTask.

:subtasks :graph {

:task1 :subTask :subtask1.
:subtask1 a :Completed.

:task1 :subTask :subtask2.
:subtask2 a :Completed.

:task1 :subTask :subtask3.
:subtask3 a :Completed.

:task2 :subTask :subtask4.
:subtask4 a :Completed.

:task2 :subTask :subtask5.
#:subtask5 a :Completed.

}.
{ ?Task a :CompositeTask. :subtasks :graph ?Graph.
  ({?Task :subTask ?Subtask} {?Subtask a :Completed}) log:forAllIn ?Graph.
} => { ?Task a :AllTasksCompleted }.
