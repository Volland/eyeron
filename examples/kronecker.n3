# Constructing consequences from finite data
#
# People, memberships, and parent links supply a finite reasoning problem.
# N3 rules derive linked consequences, with additional examples of
# arithmetic, generated witnesses, and explicitly scoped graph tests.

@prefix ex: <https://example.org/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .

# DATA (finite ground facts)
ex:Alice a ex:Person ;
    ex:age "29"^^xsd:integer ;
    ex:memberOf ex:TeamA ;
    ex:parent ex:Bob .
ex:Bob a ex:Person ;
    ex:age "54"^^xsd:integer ;
    ex:memberOf ex:TeamA ;
    ex:parent ex:Carol .
ex:Carol a ex:Person ;
    ex:age "78"^^xsd:integer ;
    ex:memberOf ex:OrgX .

ex:TeamA a ex:Team ;
    ex:partOf ex:OrgX .
ex:OrgX a ex:Org .

ex:Proj1 a ex:Project ;
    ex:ownedBy ex:OrgX ;
    ex:hasManager ex:Bob .
ex:Proj2 a ex:Project ;
    ex:ownedBy ex:OrgX ;
    ex:needsManager true .

# SECTION A — "Kronecker-friendly" core rules
# A1) Adult classification (computable, witness-free)
{
    ?p ex:age ?n .
    ?n math:greaterThan "17"^^xsd:integer
} => {
    ?p a ex:Adult .
} .

# A2) Ancestor closure (finite on finite parent facts)
{
    ?x ex:parent ?y
} => {
    ?x ex:ancestor ?y
} .

{
    ?x ex:parent ?y .
    ?y ex:ancestor ?z
} => {
    ?x ex:ancestor ?z
} .

# A3) Membership propagates up the org tree
{
    ?p ex:memberOf ?team .
    ?team ex:partOf ?org
} => {
    ?p ex:memberOf ?org
} .

# A4) Authorization: Org members can read Org-owned projects
{
    ?p ex:memberOf ?org .
    ?proj a ex:Project ;
        ex:ownedBy ?org
} => {
    ?p ex:canRead ?proj
} .

# A5) Explanation breadcrumb
{
    ?p ex:canRead ?proj .
    ?proj ex:ownedBy ?org .
    ?p ex:memberOf ?org .
} => {
    ?p ex:reason [
        a ex:Reason ;
        ex:for ?proj ;
        ex:because "memberOf(org) & ownedBy(org)"
    ] .
} .

# SECTION B — Engineering add-ons (safe / terminating)
# B1) Auto-manager creation (terminating)
# If a project needs a manager, assign a deterministic "AutoManager" IRI.
{
    ?proj a ex:Project ;
        ex:needsManager true .
} => {
    ?proj ex:hasManager [
        a ex:Person ;
        ex:role "AutoManager"
    ] .
} .

# B2) Supervisor (safe, depth-1, still terminating)
# Create at most one supervisor per manager, and DO NOT make the supervisor
# itself a manager (so no infinite chain).
{
    ?proj ex:hasManager ?m .
} => {
    ?m ex:hasSupervisor [
        a ex:Person ;
        ex:role "Supervisor" ;
        ex:supervises ?m
    ] .
} .

# query
{
    ?S ?P ?O
} log:query {
    ?S ?P ?O
} .
