# Deriving grandparents from a property chain
#
# Grandparent is declared as a chain of two parent links. N3 rules traverse
# the declared property list and derive the corresponding grandparent
# relationships in the sample family.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:grandparent owl:propertyChainAxiom (:parent :parent) .
:alice :parent :bob .
:bob :parent :carol .
:carol :parent :dave .

# Inference rules
{
    ?P owl:propertyChainAxiom ?L .
    ?L list:firstRest (?First ?Rest) .
    ?S ?First ?Middle .
    (?Rest ?Middle) :followChain ?O
} => {
    ?S ?P ?O
} .

{
    (() ?Node) :followChain ?Node
} <= true .

{
    (?Properties ?Start) :followChain ?End
} <= {
    ?Properties list:firstRest (?Property ?Tail) .
    ?Start ?Property ?Next .
    (?Tail ?Next) :followChain ?End .
} .
