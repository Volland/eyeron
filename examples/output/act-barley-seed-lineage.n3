@prefix : <http://example.org/act/barley/cancant/> .

:mainGenome :can :GenomeCopyUnderNoDesignLaws .
:fragileGenome :can :GenomeCopyUnderNoDesignLaws .
:coatlessGenome :can :GenomeCopyUnderNoDesignLaws .
:staticGenome :can :GenomeCopyUnderNoDesignLaws .
:mainLine :can :AccurateSelfReproduction .
:coatlessLine :can :AccurateSelfReproduction .
:staticLine :can :AccurateSelfReproduction .
:mainSeed :can :Germinate .
:analogSeed :can :Germinate .
:fragileSeed :can :Germinate .
:coatlessSeed :can :Germinate .
:staticSeed :can :Germinate .
:mainAdult :can :PropaguleProduction .
:analogAdult :can :PropaguleProduction .
:fragileAdult :can :PropaguleProduction .
:coatlessAdult :can :PropaguleProduction .
:staticAdult :can :PropaguleProduction .
:mainSeed :can :ProtectedDormancy .
:mainLine :can :LineageClosure .
:mainLine :can :HeritableVariation .
:mainLine :can :AdaptivePersistence .
:analogSeed :can :ProtectedDormancy .
:analogLine :can :LineageClosure .
:analogLine :can :HeritableVariation .
:fragileSeed :can :ProtectedDormancy .
:fragileLine :can :LineageClosure .
:fragileLine :can :HeritableVariation .
:coatlessLine :can :HeritableVariation .
:coatlessLine :can :AdaptivePersistence .
:staticSeed :can :ProtectedDormancy .
:staticLine :can :LineageClosure .
:analogGenome :cannot :AccurateGenomeCopyUnderNoDesignLaws .
:analogLine :cannot :AccurateSelfReproduction .
:fragileLine :cannot :ReliableDamageCorrection .
:coatlessLine :cannot :ProtectedDormancy .
:staticLine :cannot :AdaptiveEvolution .
:analogLine :cannot :EvolvableLineage .
:fragileLine :cannot :AccurateSelfReproduction .
:coatlessLine :cannot :LineageClosure .
:staticLine :cannot :AdaptivePersistence .
:fragileLine :cannot :EvolvableLineage .
:coatlessLine :cannot :EvolvableLineage .
:staticLine :cannot :EvolvableLineage .
:mainLine a :EvolvableLineage .
