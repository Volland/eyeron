# Exploring a cycle of absence tests
#
# Two N3 rules each derive a classification when the other is absent. The
# example exposes eyeron's behavior for this negative cycle using scoped
# negation as failure.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/unstratified-negation#> .

:alice a :Person .

{
    ?x a :Person .
    ?SCOPE log:notIncludes {
        ?x a :Out
    } .
} => {
    ?x a :In
} .

{
    ?x a :Person .
    ?SCOPE log:notIncludes {
        ?x a :In
    } .
} => {
    ?x a :Out
} .
