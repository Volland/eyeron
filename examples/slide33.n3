# Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Source: https://eyereasoner.github.io/eye/reasoning/slide33/
# Standalone program; EYE answer directives use log:query.

# Source file: slide33/slide33.n3
@base <https://eyereasoner.github.io/eye/reasoning/slide33/slide33.n3>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix : <http://example.org/#>.

# owl restriction
:aaa owl:onProperty :bbb.
:aaa owl:allValuesFrom :ccc.

# the following should entail :xxx a :aaa.
{
    :xxx :bbb ?y.
} => {
    ?y a :ccc.
}.

# owl:allValuseFrom description logic
{
    ?a owl:onProperty ?b.
    ?a owl:allValuesFrom ?c.
    {
        ?x ?b ?y.
    } => {
        ?y a ?c.
    }.
} => {
    {
        ?x a ?a.
        ?x ?b ?y.
    } => {
        ?y a ?c.
    }.
    ?x a ?a.
}.


# Query: slide33/slide33-query.n3
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{
    ?S a ?C .
} log:query {
    ?S a ?C .
} .

