# Inferring a restriction from a quoted rule
#
# Property-restriction facts accompany a rule about values reached from one
# subject. An N3 rule matches that implication and derives a more general
# restriction rule together with a class membership.

@base <https://eyereasoner.github.io/eye/reasoning/slide33/slide33.n3> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://example.org/#> .

# owl restriction
:aaa owl:onProperty :bbb .
:aaa owl:allValuesFrom :ccc .

# the following should entail :xxx a :aaa.
{
    :xxx :bbb ?y .
} => {
    ?y a :ccc .
} .

# owl:allValuseFrom description logic
{
    ?a owl:onProperty ?b .
    ?a owl:allValuesFrom ?c .
    {
        ?x ?b ?y .
    } => {
        ?y a ?c .
    } .
} => {
    {
        ?x a ?a .
        ?x ?b ?y .
    } => {
        ?y a ?c .
    } .
    ?x a ?a .
} .

# Query
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{
    ?S a ?C .
} log:query {
    ?S a ?C .
} .
