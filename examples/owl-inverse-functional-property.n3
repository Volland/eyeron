# Equating people who share an identifying account
#
# An account property is declared inverse functional, and two person names
# share one account. An explicit N3 rule derives equality between those
# names from the common value.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:account a owl:InverseFunctionalProperty .
:alice :account :shared .
:aliceAlias :account :shared .

# Inference rules
@prefix owl: <http://www.w3.org/2002/07/owl#> .

{
    ?P a owl:InverseFunctionalProperty .
    ?X ?P ?O .
    ?Y ?P ?O
} => {
    ?X owl:sameAs ?Y
} .

{
    ?P a owl:InverseFunctionalProperty .
    ?X ?P ?O .
    ?Y ?P ?O .
    ?X owl:differentFrom ?Y
} => false .
