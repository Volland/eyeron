# Calculating powers modulo an integer
#
# A modular-power query is reduced by repeatedly squaring and splitting
# even and odd exponents. Recursive backward N3 rules combine integer
# arithmetic to derive the sample remainders.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix : <http://example.org/modular-exponentiation#> .

{
    (?b 0 ?m) :modPow ?r
} <= {
    ?m math:greaterThan 0 .
    (1 ?m) math:remainder ?r
} .

{
    (?b 1 ?m) :modPow ?r
} <= {
    ?m math:greaterThan 0 .
    (?b ?m) math:remainder ?r
} .

{
    (?b ?e ?m) :modPow ?r
} <= {
    ?m math:greaterThan 0 .
    ?e math:greaterThan 1 .
    (?e 2) math:remainder 0 .
    (?b ?b) math:product ?bb .
    (?bb ?m) math:remainder ?squared .
    (?e 2) math:integerQuotient ?half .
    (?squared ?half ?m) :modPow ?r .
} .

{
    (?b ?e ?m) :modPow ?r
} <= {
    ?m math:greaterThan 0 .
    ?e math:greaterThan 1 .
    (?e 2) math:remainder 1 .
    (?b ?b) math:product ?bb .
    (?bb ?m) math:remainder ?squared .
    (?e 1) math:difference ?e1 .
    (?e1 2) math:integerQuotient ?half .
    (?squared ?half ?m) :modPow ?tail .
    (?b ?tail) math:product ?bt .
    (?bt ?m) math:remainder ?r .
} .

{
    (7 13 97) :modPow ?r
} => {
    :test :smallCheck ?r
} .

{
    (7 1000000000 1000003) :modPow ?r
} => {
    :test :largeCase ?r
} .
