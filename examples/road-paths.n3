# Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Sources: https://eyereasoner.github.io/eye/reasoning/arcus/graph/graph.ttl
# Premise blank nodes are named variables; backward answers are materialized.

@prefix : <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

:paris :oneway :orleans .
:paris :oneway :chartres .
:paris :oneway :amiens .
:orleans :oneway :blois .
:orleans :oneway :bourges .
:blois :oneway :tours .
:chartres :oneway :lemans .
:lemans :oneway :angers .
:lemans :oneway :tours .
:angers :oneway :nantes .

{
    ?A :oneway ?B .
} => {
    ?A :path ?B .
} .

{
    ?A :path ?B .
    ?B :path ?C .
} => {
    ?A :path ?C .
} .

{
    ?A :path :nantes .
} => {
    ?A :path :nantes .
} .

{
    ?A :path :nantes .
} log:query {
    ?A :path :nantes .
} .
