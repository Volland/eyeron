# Appending lists and finding members
#
# Lists of named items supply two small queries. A recursive backward N3
# rule appends lists, while a membership built-in enumerates the values in
# another list.

@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/lists#> .

{
    (?xs ?ys) :append ?zs
} <= {
    ?xs list:firstRest (?x ?xrest) .
    (?xrest ?ys) :append ?zsrest .
    ?zs list:firstRest (?x ?zsrest) .
} .

{
    (() ?ys) :append ?ys
} <= true .

{
    ((:a) (:b)) :append ?result
} => {
    :query :appendResult ?result
} .

{
    (:a :b :a) list:member ?x
} => {
    :query :member ?x
} .
