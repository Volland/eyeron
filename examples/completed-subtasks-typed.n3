# Adapted from EYE reasoning examples (MIT, Jos De Roo).
# Source: https://eyereasoner.github.io/eye/reasoning/twf/
# Standalone program; EYE answer directives use log:query.

# Source file: twf/example28.n3
@base <https://eyereasoner.github.io/eye/reasoning/twf/example28.n3>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix : <http://example.com/>.

:workflowA a :Workflow ;
    :includes :taskA , :taskB .
:taskA a :Completed .
:taskB a :Completed .

{ ?workflow a :Workflow.
  (?task { ?workflow :includes ?task . ?task a :Completed } ?completed) log:collectAllIn ?SCOPE .

} => { ?workflow :completed ?completed } .

