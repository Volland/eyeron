# Combining literals and quoted statement evidence
#
# The sample data contains typed strings, language and direction tags, and
# a quoted statement with a source. N3 rules derive display and provenance
# facts from these representations.

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://example/> .

:alice :name "Alice"^^xsd:string .
:alice :label "Bonjour"@fr .
:alice :age 42 .
:document :title "HTML و CSS"@ar--rtl .

[ ] :statement {
    :alice :knows :bob
} ;
    :source :chat .

{
    ?person :label ?label
} => {
    ?person :displayName ?label
} .

{
    ?person :name ?text
} => {
    :test :namedPerson ?person ;
        :namedText ?text
} .

{
    :document :title ?title
} => {
    :test :title ?title
} .

{
    ?claim :statement {
        ?s :knows ?o
    } .
    ?claim :source ?source
} => {
    :test :knowsSource ?source ;
        :knowsSubject ?s ;
        :knowsObject ?o
} .
