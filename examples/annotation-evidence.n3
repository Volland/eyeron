# Finding the source of a quoted statement
#
# A claim records a statement, its author, and a date. N3 rules inspect the
# quoted graph and its metadata to derive which claim and source support
# the statement.

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example/> .

:alice :name "Alice" .
:claim :statement {
    :alice :name "Alice"
} ;
    :statedBy :bob ;
    :recorded "2021-07-07"^^xsd:date .

{
    :alice :name "Alice"
} => {
    :test :hasStatement true
} .

{
    ?claim :statement {
        :alice :name "Alice"
    }
} => {
    :test :hasNamedStatement ?claim
} .

{
    ?claim :statement {
        :alice :name "Alice"
    } .
    ?claim :statedBy ?who
} => {
    :test :statementAuthor ?who
} .

{
    ?claim :statement {
        :alice :name "Alice"
    } .
    ?claim :recorded ?date
} => {
    :test :statementDate ?date
} .
