# Collecting names that pass a text filter
#
# Three names are compared with a text threshold. Scoped N3 collection
# gathers the matching names into a list, and the query checks its length
# before returning it.

@base <https://eyereasoner.github.io/eye/reasoning/filter/filter.n3> .
@prefix : <http://example.org/#> .

# facts
:Let :param "Huey" .
:Let :param "Dewey" .
:Let :param "Louie" .

# Query
@prefix : <http://example.org/#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{
    (
        ?param {
            :Let :param ?param .
            ?param string:lessThan "Louie" .
        }
        ?filteredParams
    ) log:collectAllIn ?scope .
    ?filteredParams list:length 2 .
} log:query {
    :result :is ?filteredParams .
} .
