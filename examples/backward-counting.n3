# Standalone program; EYE answer directives use log:query.

# Source file: bcrule/example4.n3
@base <https://eyereasoner.github.io/eye/reasoning/bcrule/example4.n3>.
@prefix math: <http://www.w3.org/2000/10/swap/math#>.
@prefix : <http://example.org/#>.

:alice :canCountTo 1.
{ ?x :canCountTo ?s. } <= { ?s math:greaterThan 1. (?s 1) math:difference ?n.  ?x :canCountTo ?n. }.

{ :alice :canCountTo 10 } => { :TEST :PASS 1 }.

