# A comparison written before its input fact
#
# Alice has a score, but the rule writes its numeric comparison before the
# clause that binds that score. Eyeron resolves the premises and derives
# the classification, illustrating premise reordering.

@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix : <https://eyereasoner.github.io/eyepl/examples/well-formedness-error#> .

:alice :score 10 .

{
    ?score math:greaterThan 5 .
    :alice :score ?score .
} => {
    :alice a :Bad
} .
