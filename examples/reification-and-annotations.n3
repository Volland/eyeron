# Connecting statements to their sources
#
# Alice's statement is asserted and separately described by a claim node,
# while Bob's statement is quoted. N3 rules inspect the claim graphs and
# metadata to derive statement-source relationships.

@prefix : <http://example/> .

:alice :says :hello .
[ ] :statement {
    :alice :says :hello
} ;
    :source :chat ;
    :certainty 0.9 .

:bobClaim :statement {
    :bob :says :hi
} ;
    :source :email .

{
    ?claim :statement {
        ?speaker :says ?object
    } .
    ?claim :source ?source
} => {
    ?speaker :statementSource ?source
} .
