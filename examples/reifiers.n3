# Deriving provenance from quoted statements
#
# Two claim nodes each connect a quoted statement to a source. N3 rules
# match the speaker within each graph and derive where that speaker's
# statement came from.

@prefix : <http://example/> .

:claim1 :statement {
    :alice :says "hello"
} .

:claim1 :source :chat .
:claim2 :statement {
    :bob :says "hi"
} .

:claim2 :source :email .

{
    ?claim :statement {
        ?speaker :says ?object
    } .
    ?claim :source ?source
} => {
    ?speaker :statementSource ?source
} .
