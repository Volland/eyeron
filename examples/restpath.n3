# Composing a path of described web requests
#
# An initial relation supplies a starting point for service descriptions.
# N3 rules generate request and response descriptions and compose them into
# a derived path; the requests are represented as data.

@base <https://eyereasoner.github.io/eye/reasoning/restpath/initial.n3> .
@prefix ex: <http://example.org/#> .

<x> ex:rel1 <y> .

@base <https://eyereasoner.github.io/eye/reasoning/restpath/path-9-3.n3> .
@prefix ex: <http://example.org/#> .
@prefix http: <http://www.w3.org/2011/http#> .

{
    ?a1 ex:rel1 ?b1 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel2 ?b1 .
    ?a2 ex:rel2 ?b2 .
    ?a3 ex:rel2 ?b3 .
} .

{
    ?a1 ex:rel2 ?b1 .
    ?a2 ex:rel2 ?b2 .
    ?a3 ex:rel2 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel3 ?b1 .
    ?a2 ex:rel3 ?b2 .
    ?a3 ex:rel3 ?b3 .
} .

{
    ?a1 ex:rel3 ?b1 .
    ?a2 ex:rel3 ?b2 .
    ?a3 ex:rel3 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel4 ?b1 .
    ?a2 ex:rel4 ?b2 .
    ?a3 ex:rel4 ?b3 .
} .

{
    ?a1 ex:rel4 ?b1 .
    ?a2 ex:rel4 ?b2 .
    ?a3 ex:rel4 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel5 ?b1 .
    ?a2 ex:rel5 ?b2 .
    ?a3 ex:rel5 ?b3 .
} .

{
    ?a1 ex:rel5 ?b1 .
    ?a2 ex:rel5 ?b2 .
    ?a3 ex:rel5 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel6 ?b1 .
    ?a2 ex:rel6 ?b2 .
    ?a3 ex:rel6 ?b3 .
} .

{
    ?a1 ex:rel6 ?b1 .
    ?a2 ex:rel6 ?b2 .
    ?a3 ex:rel6 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel7 ?b1 .
    ?a2 ex:rel7 ?b2 .
    ?a3 ex:rel7 ?b3 .
} .

{
    ?a1 ex:rel7 ?b1 .
    ?a2 ex:rel7 ?b2 .
    ?a3 ex:rel7 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel8 ?b1 .
    ?a2 ex:rel8 ?b2 .
    ?a3 ex:rel8 ?b3 .
} .

{
    ?a1 ex:rel8 ?b1 .
    ?a2 ex:rel8 ?b2 .
    ?a3 ex:rel8 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel9 ?b1 .
    ?a2 ex:rel9 ?b2 .
    ?a3 ex:rel9 ?b3 .
} .

{
    ?a1 ex:rel9 ?b1 .
    ?a2 ex:rel9 ?b2 .
    ?a3 ex:rel9 ?b3 .
} => {
    ?request http:methodName "GET" .
    ?request http:requestURI ?a1 .
    ?request http:resp ?resp .
    ?resp http:body ?b1 .
    ?a1 ex:rel10 ?b1 .
    ?a2 ex:rel10 ?b2 .
    ?a3 ex:rel10 ?b3 .
    ?a1 ex:relGoal ?b1 .
} .

# Query
@prefix ex: <http://example.org/#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

{
    <https://eyereasoner.github.io/eye/reasoning/restpath/x> ex:relGoal <https://eyereasoner.github.io/eye/reasoning/restpath/y> .
} log:query {
    <https://eyereasoner.github.io/eye/reasoning/restpath/x> ex:relGoal <https://eyereasoner.github.io/eye/reasoning/restpath/y> .
} .
