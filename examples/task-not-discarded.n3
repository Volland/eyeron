# Checking for a discarded task in one document
#
# An embedded graph lists tasks without discarded classifications. N3 rules
# use log:notIncludes within that graph to derive the sample not-discarded
# conclusions.

@prefix : <http://example.org/test#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

:task1 a :CompositeTask .

:task2 a :CompositeTask .

:tasks :graph {

    :task1 a :CompositeTask .

    :task2 a :CompositeTask .
} .

{
    ?Task a :CompositeTask .
    :tasks :graph ?Graph .
    ?Graph log:notIncludes {
        ?Task a :DiscardedTask
    }
} => {
    ?Task a :NotDiscardedTask
} .
