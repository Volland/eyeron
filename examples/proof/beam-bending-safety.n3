    { 22499.999999999993 math:greaterThan 11249.999999999996 . },
    { 11249.999999999996 math:greaterThan 5000.000000000001 . },
    { 2.3999999999999995 math:greaterThan 1.066666666666667 . }.

{ :FloorOverload :safetyFactor 0.5333333333333335 . }
  pe:rule 4;
  pe:binding
    [ pe:var "B"; pe:value :FloorOverload ],
    [ pe:var "allow"; pe:value 12000.0 ],
    [ pe:var "sf"; pe:value 0.5333333333333335 ],
    [ pe:var "sigma"; pe:value 22499.999999999993 ];
  pe:uses
    { :FloorOverload :bendingStress 22499.999999999993 . },
    { :FloorOverload :allowableStress 12000.0 . },
    { (12000.0 22499.999999999993) math:quotient 0.5333333333333335 . }.

{ (12000.0 22499.999999999993) math:quotient 0.5333333333333335 . }
  pe:builtin math:quotient.

{ 22499.999999999993 math:greaterThan 11249.999999999996 . }
  pe:builtin math:greaterThan.

{ 11249.999999999996 math:greaterThan 5000.000000000001 . }
  pe:builtin math:greaterThan.

{ :check1 :ok true . }
  pe:rule 9;
  pe:binding
    [ pe:var "b1"; pe:value true ],
