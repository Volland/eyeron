    [ pe:var "s1"; pe:value 8333.333333333334 ],
    [ pe:var "s2"; pe:value 11249.999999999996 ],
    [ pe:var "s3"; pe:value 22499.999999999993 ],
    [ pe:var "s4"; pe:value 5000.000000000001 ];
  pe:uses
    { :ShelfLight :bendingStress 8333.333333333334 . },
    { :ShelfLight :safetyFactor 1.44 . },
    { :ShelfLight :isSafe true . },
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorBase :isSafe true . },
    { :FloorOverload :bendingStress 22499.999999999993 . },
    { :FloorOverload :safetyFactor 0.5333333333333335 . },
    { :FloorOverload :isSafe false . },
    { :FloorTall :bendingStress 5000.000000000001 . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { :FloorTall :isSafe true . }.

{ :check1 :msg "Check 1: all example beam designs have a derived bending stress, safety factor and safety classification." . }
  pe:rule 9;
  pe:binding
    [ pe:var "b1"; pe:value true ],
    [ pe:var "b2"; pe:value true ],
    [ pe:var "b3"; pe:value false ],
    [ pe:var "b4"; pe:value true ],
    [ pe:var "f1"; pe:value 1.44 ],
    [ pe:var "f2"; pe:value 1.066666666666667 ],
    [ pe:var "f3"; pe:value 0.5333333333333335 ],
