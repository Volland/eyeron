    [ pe:var "s1"; pe:value 8333.333333333334 ],
    [ pe:var "s2"; pe:value 11249.999999999996 ],
    [ pe:var "s3"; pe:value 22499.999999999993 ],
    [ pe:var "s4"; pe:value 5000.000000000001 ];
  pe:uses
    { :ShelfLight :bendingStress 8333.333333333334 . },
    { :ShelfLight :safetyFactor 1.44 . },
    { :ShelfLight :isSafe true . },
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorBase :isSafe true . },
    { :FloorOverload :bendingStress 22499.999999999993 . },
    { :FloorOverload :safetyFactor 0.5333333333333335 . },
    { :FloorOverload :isSafe false . },
    { :FloorTall :bendingStress 5000.000000000001 . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { :FloorTall :isSafe true . }.

{ :check2 :ok true . }
  pe:rule 10;
  pe:binding
    [ pe:var "Pbase"; pe:value 5.0 ],
    [ pe:var "Pover"; pe:value 10.0 ],
    [ pe:var "sigmaBase"; pe:value 11249.999999999996 ],
    [ pe:var "sigmaOver"; pe:value 22499.999999999993 ];
  pe:uses
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorBase :pointLoad 5.0 . },
    { :FloorOverload :bendingStress 22499.999999999993 . },
    { :FloorOverload :pointLoad 10.0 . },
    { 10.0 math:greaterThan 5.0 . },
    { 22499.999999999993 math:greaterThan 11249.999999999996 . }.

{ 10.0 math:greaterThan 5.0 . }
  pe:builtin math:greaterThan.

{ :check2 :msg "Check 2: the overloaded FloorOverload beam carries a higher point load than FloorBase and has a strictly higher bending stress, as expected from sigma = (P·L/4)/S." . }
  pe:rule 10;
  pe:binding
    [ pe:var "Pbase"; pe:value 5.0 ],
    [ pe:var "Pover"; pe:value 10.0 ],
    [ pe:var "sigmaBase"; pe:value 11249.999999999996 ],
    [ pe:var "sigmaOver"; pe:value 22499.999999999993 ];
  pe:uses
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorBase :pointLoad 5.0 . },
    { :FloorOverload :bendingStress 22499.999999999993 . },
    { :FloorOverload :pointLoad 10.0 . },
    { 10.0 math:greaterThan 5.0 . },
    { 22499.999999999993 math:greaterThan 11249.999999999996 . }.

{ :check3 :ok true . }
  pe:rule 11;
  pe:binding
    [ pe:var "hBase"; pe:value 0.2 ],
    [ pe:var "hTall"; pe:value 0.3 ],
    [ pe:var "sigmaBase"; pe:value 11249.999999999996 ],
    [ pe:var "sigmaTall"; pe:value 5000.000000000001 ];
  pe:uses
    { :FloorBase :height 0.2 . },
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorTall :height 0.3 . },
    { :FloorTall :bendingStress 5000.000000000001 . },
    { 0.3 math:greaterThan 0.2 . },
    { 11249.999999999996 math:greaterThan 5000.000000000001 . }.

{ 0.3 math:greaterThan 0.2 . }
  pe:builtin math:greaterThan.

{ :check3 :msg "Check 3: the taller FloorTall beam has a greater height than FloorBase and a strictly lower bending stress, consistent with the section modulus S growing proportional to h²." . }
  pe:rule 11;
  pe:binding
    [ pe:var "hBase"; pe:value 0.2 ],
    [ pe:var "hTall"; pe:value 0.3 ],
    [ pe:var "sigmaBase"; pe:value 11249.999999999996 ],
    [ pe:var "sigmaTall"; pe:value 5000.000000000001 ];
  pe:uses
    { :FloorBase :height 0.2 . },
    { :FloorBase :bendingStress 11249.999999999996 . },
    { :FloorTall :height 0.3 . },
    { :FloorTall :bendingStress 5000.000000000001 . },
    { 0.3 math:greaterThan 0.2 . },
    { 11249.999999999996 math:greaterThan 5000.000000000001 . }.

{ :check4 :ok true . }
  pe:rule 12;
  pe:binding
    [ pe:var "sfBase"; pe:value 1.066666666666667 ],
    [ pe:var "sfOver"; pe:value 0.5333333333333335 ],
    [ pe:var "sfShelf"; pe:value 1.44 ],
    [ pe:var "sfTall"; pe:value 2.3999999999999995 ];
  pe:uses
    { :ShelfLight :isSafe true . },
    { :ShelfLight :safetyFactor 1.44 . },
    { :FloorBase :isSafe true . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorTall :isSafe true . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { :FloorOverload :isSafe false . },
    { :FloorOverload :safetyFactor 0.5333333333333335 . },
    { 1.44 math:notLessThan 1.0 . },
    { 1.066666666666667 math:notLessThan 1.0 . },
    { 2.3999999999999995 math:notLessThan 1.0 . },
    { 0.5333333333333335 math:lessThan 1.0 . }.

{ 1.44 math:notLessThan 1.0 . }
  pe:builtin math:notLessThan.

{ 1.066666666666667 math:notLessThan 1.0 . }
  pe:builtin math:notLessThan.

{ 2.3999999999999995 math:notLessThan 1.0 . }
  pe:builtin math:notLessThan.

{ 0.5333333333333335 math:lessThan 1.0 . }
  pe:builtin math:lessThan.

{ :check4 :msg "Check 4: every design classified as safe has a safety factor of at least one, while the overloaded FloorOverload design has a safety factor below one." . }
  pe:rule 12;
  pe:binding
    [ pe:var "sfBase"; pe:value 1.066666666666667 ],
    [ pe:var "sfOver"; pe:value 0.5333333333333335 ],
    [ pe:var "sfShelf"; pe:value 1.44 ],
    [ pe:var "sfTall"; pe:value 2.3999999999999995 ];
  pe:uses
    { :ShelfLight :isSafe true . },
    { :ShelfLight :safetyFactor 1.44 . },
    { :FloorBase :isSafe true . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorTall :isSafe true . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { :FloorOverload :isSafe false . },
    { :FloorOverload :safetyFactor 0.5333333333333335 . },
    { 1.44 math:notLessThan 1.0 . },
    { 1.066666666666667 math:notLessThan 1.0 . },
    { 2.3999999999999995 math:notLessThan 1.0 . },
    { 0.5333333333333335 math:lessThan 1.0 . }.

{ :check5 :ok true . }
  pe:rule 13;
  pe:binding
    [ pe:var "sfBase"; pe:value 1.066666666666667 ],
    [ pe:var "sfShelf"; pe:value 1.44 ],
    [ pe:var "sfTall"; pe:value 2.3999999999999995 ];
  pe:uses
    { :ShelfLight :safetyFactor 1.44 . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { 2.3999999999999995 math:greaterThan 1.44 . },
    { 2.3999999999999995 math:greaterThan 1.066666666666667 . }.

{ :check5 :msg "Check 5: among the safe designs, FloorTall has the largest safety factor, confirming that increasing the beam height in this model gives the greatest margin against the allowable bending stress." . }
  pe:rule 13;
  pe:binding
    [ pe:var "sfBase"; pe:value 1.066666666666667 ],
    [ pe:var "sfShelf"; pe:value 1.44 ],
    [ pe:var "sfTall"; pe:value 2.3999999999999995 ];
  pe:uses
    { :ShelfLight :safetyFactor 1.44 . },
    { :FloorBase :safetyFactor 1.066666666666667 . },
    { :FloorTall :safetyFactor 2.3999999999999995 . },
    { 2.3999999999999995 math:greaterThan 1.44 . },
    { 2.3999999999999995 math:greaterThan 1.066666666666667 . }.
