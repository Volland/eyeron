        :consent-b a dpv:Consent .
    } ],
    [ pe:var "doc"; pe:value doc:consent ],
    [ pe:var "label"; pe:value "verifiable-decision.n3" ],
    [ pe:var "root"; pe:value {
        :agreement-42 a odrl:Agreement .
    } ];
  pe:uses
    { :audit a dpv:Audit . },
    {
        :audit dpv:hasScope {
            :agreement-42 a odrl:Agreement .
        } .
    },
    {
        {
            :agreement-42 a odrl:Agreement .
        } prov:wasDerivedFrom {
            :consent-b a dpv:Consent .
        } .
    },
    {
        {
            :consent-b a dpv:Consent .
        } pe:fact "verifiable-decision.n3" .
    },
    {
        {
            :consent-b a dpv:Consent .
        } prov:hadPrimarySource doc:consent .
    }.

