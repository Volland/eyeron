@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:childOf owl:inverseOf :parentOf .
:bob :childOf :alice .
:dave :parentOf :carol .

{ :childOf owl:inverseOf :parentOf . }
  pe:rule 3;
  pe:binding
    [ pe:var "P"; pe:value :parentOf ],
    [ pe:var "Q"; pe:value :childOf ];
  pe:uses { :parentOf owl:inverseOf :childOf . }.

{ :parentOf owl:inverseOf :childOf . }
  pe:fact "owl-inverse-properties.n3".

{ :bob :childOf :alice . }
  pe:rule 1;
  pe:binding
    [ pe:var "O"; pe:value :bob ],
    [ pe:var "P"; pe:value :parentOf ],
    [ pe:var "Q"; pe:value :childOf ],
    [ pe:var "S"; pe:value :alice ];
  pe:uses
    { :parentOf owl:inverseOf :childOf . },
    { :alice :parentOf :bob . }.

{ :alice :parentOf :bob . }
  pe:fact "owl-inverse-properties.n3".

{ :dave :parentOf :carol . }
  pe:rule 1;
  pe:binding
    [ pe:var "O"; pe:value :dave ],
    [ pe:var "P"; pe:value :childOf ],
    [ pe:var "Q"; pe:value :parentOf ],
    [ pe:var "S"; pe:value :carol ];
  pe:uses
    { :childOf owl:inverseOf :parentOf . },
    { :carol :childOf :dave . }.

{ :carol :childOf :dave . }
  pe:fact "owl-inverse-properties.n3".
