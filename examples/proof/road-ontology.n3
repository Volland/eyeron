{ :paris :path :blois . }
  pe:rule 7;
  pe:binding
    [ pe:var "O"; pe:value :blois ],
    [ pe:var "P"; pe:value :path ],
    [ pe:var "S"; pe:value :paris ],
    [ pe:var "X"; pe:value :orleans ];
  pe:uses
    { :path a owl:TransitiveProperty . },
    { :orleans :path :blois . },
    { :paris :path :orleans . }.

{ :path a owl:TransitiveProperty . }
  pe:fact "road-ontology.n3".

{ :paris :path :bourges . }
  pe:rule 7;
  pe:binding
    [ pe:var "O"; pe:value :bourges ],
    [ pe:var "P"; pe:value :path ],
    [ pe:var "S"; pe:value :paris ],
