@prefix : <http://www.agfa.com/w3c/euler/graph.axiom#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:oneway a rdf:Property .
:path a rdf:Property .
:paris :path :orleans .
:paris :path :chartres .
:paris :path :amiens .
:orleans :path :blois .
:orleans :path :bourges .
:blois :path :tours .
:chartres :path :lemans .
:lemans :path :angers .
:lemans :path :tours .
:angers :path :nantes .
:paris :path :blois .
:paris :path :bourges .
:orleans :path :tours .
:paris :path :lemans .
:chartres :path :angers .
:chartres :path :tours .
:lemans :path :nantes .
:paris :path :tours .
:paris :path :angers .
:chartres :path :nantes .
:paris :path :nantes .

{ :oneway a rdf:Property . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value rdf:Property ],
    [ pe:var "O"; pe:value :path ],
    [ pe:var "P"; pe:value rdfs:subPropertyOf ],
    [ pe:var "S"; pe:value :oneway ];
  pe:uses
    { rdfs:subPropertyOf rdfs:domain rdf:Property . },
    { :oneway rdfs:subPropertyOf :path . }.

{ rdfs:subPropertyOf rdfs:domain rdf:Property . }
  pe:fact "road-ontology.n3".

{ :oneway rdfs:subPropertyOf :path . }
  pe:fact "road-ontology.n3".

{ :path a rdf:Property . }
  pe:rule 2;
  pe:binding
    [ pe:var "C"; pe:value rdf:Property ],
    [ pe:var "O"; pe:value :path ],
    [ pe:var "P"; pe:value rdfs:subPropertyOf ],
    [ pe:var "S"; pe:value :oneway ];
  pe:uses
    { rdfs:subPropertyOf rdfs:range rdf:Property . },
    { :oneway rdfs:subPropertyOf :path . }.

{ rdfs:subPropertyOf rdfs:range rdf:Property . }
  pe:fact "road-ontology.n3".

{ :paris :path :orleans . }
  pe:rule 4;
  pe:binding
    [ pe:var "O"; pe:value :orleans ],
    [ pe:var "P"; pe:value :oneway ],
    [ pe:var "R"; pe:value :path ],
    [ pe:var "S"; pe:value :paris ];
  pe:uses
    { :oneway rdfs:subPropertyOf :path . },
    { :paris :oneway :orleans . }.

{ :paris :oneway :orleans . }
  pe:fact "road-ontology.n3".

{ :paris :path :chartres . }
  pe:rule 4;
  pe:binding
    [ pe:var "O"; pe:value :chartres ],
    [ pe:var "P"; pe:value :oneway ],
    [ pe:var "R"; pe:value :path ],
    [ pe:var "S"; pe:value :paris ];
  pe:uses
    { :oneway rdfs:subPropertyOf :path . },
    { :paris :oneway :chartres . }.

{ :paris :oneway :chartres . }
  pe:fact "road-ontology.n3".

