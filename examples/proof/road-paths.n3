@prefix : <http://example.org/#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:paris :path :orleans .
:paris :path :chartres .
:paris :path :amiens .
:orleans :path :blois .
:orleans :path :bourges .
:blois :path :tours .
:chartres :path :lemans .
:lemans :path :angers .
:lemans :path :tours .
:angers :path :nantes .
:paris :path :blois .
:paris :path :bourges .
:paris :path :lemans .
:orleans :path :tours .
:paris :path :tours .
:chartres :path :angers .
:chartres :path :tours .
:lemans :path :nantes .
:paris :path :angers .
:chartres :path :nantes .
:paris :path :nantes .

{ :paris :path :orleans . }
  pe:rule 1;
  pe:binding
    [ pe:var "A"; pe:value :paris ],
    [ pe:var "B"; pe:value :orleans ];
  pe:uses { :paris :oneway :orleans . }.

{ :paris :oneway :orleans . }
  pe:fact "road-paths.n3".

