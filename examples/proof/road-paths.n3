{ :paris :path :blois . }
  pe:rule 2;
  pe:binding
    [ pe:var "A"; pe:value :paris ],
    [ pe:var "B"; pe:value :orleans ],
    [ pe:var "C"; pe:value :blois ];
  pe:uses
    { :paris :path :orleans . },
    { :orleans :path :blois . }.

