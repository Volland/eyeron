{ _:g a food:SweetFruit . }
  pe:rule 1;
  pe:binding
    [ pe:var "C"; pe:value food:Grape ],
    [ pe:var "D"; pe:value food:SweetFruit ],
    [ pe:var "X"; pe:value _:g ];
  pe:uses
    { food:Grape rdfs:subClassOf food:SweetFruit . },
    { _:g a food:Grape . }.

{ food:Grape rdfs:subClassOf food:SweetFruit . }
  pe:fact "owl-food-ontology.n3".

{ _:g a food:Grape . }
  pe:fact "owl-food-ontology.n3".

