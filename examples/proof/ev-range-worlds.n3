    { :MountainCool :safeInWorld :W0 . },
    { :MountainCool :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.

{ :check1 :msg "Check 1: on these trips, the cautious world W3 is at least as conservative as the reference world W0: every trip that W3 treats as safe is also safe in W0, and W3 rejects all trips that W0 rejects, plus one more." . }
  pe:rule 20;
  pe:uses
    { :CityShort :safeInWorld :W0 . },
    { :CityShort :safeInWorld :W3 . },
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :MountainCool :safeInWorld :W0 . },
    { :MountainCool :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.

{ :check2 :ok true . }
  pe:rule 21;
  pe:uses
    { :HighwayLongCold :safeInWorld :W1 . },
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :safeInWorld :W1 . },
    { :ColdHighwayMidBattery :safeInWorld :W2 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.

{ :check2 :msg "Check 2: on the harsher highway trips, the naive world W1 is the most optimistic: it alone treats HighwayLongCold as safe, and together with W2 it also marks ColdHighwayMidBattery as safe despite the penalties of cold and heavy load seen by W0 and W3." . }
  pe:rule 21;
  pe:uses
    { :HighwayLongCold :safeInWorld :W1 . },
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :safeInWorld :W1 . },
    { :ColdHighwayMidBattery :safeInWorld :W2 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.

{ :check3 :ok true . }
  pe:rule 22;
  pe:uses
    { :CityShort :safeInWorld :W0 . },
    { :CityShort :safeInWorld :W1 . },
    { :CityShort :safeInWorld :W2 . },
    { :CityShort :safeInWorld :W3 . }.

{ :check3 :msg "Check 3: all four worlds agree that the short, warm CityShort trip is safe, so the different models converge on an uncontroversial scenario." . }
  pe:rule 22;
  pe:uses
    { :CityShort :safeInWorld :W0 . },
    { :CityShort :safeInWorld :W1 . },
    { :CityShort :safeInWorld :W2 . },
    { :CityShort :safeInWorld :W3 . }.

{ :check4 :ok true . }
  pe:rule 23;
  pe:uses
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :HighwayLongCold :safeInWorld :W1 . },
    { :MountainCool :safeInWorld :W0 . },
    { :MountainCool :safeInWorld :W1 . },
    { :MountainCool :safeInWorld :W2 . },
    { :MountainCool :riskyInWorld :W3 . }.

{ :check4 :msg "Check 4: the semi-optimistic world W2 behaves like a middle ground: it agrees with the cautious worlds W0 and W3 that HighwayLongCold is risky, but it joins the optimistic worlds W0 and W1 in judging MountainCool as safe." . }
  pe:rule 23;
  pe:uses
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :HighwayLongCold :safeInWorld :W1 . },
    { :MountainCool :safeInWorld :W0 . },
    { :MountainCool :safeInWorld :W1 . },
    { :MountainCool :safeInWorld :W2 . },
    { :MountainCool :riskyInWorld :W3 . }.

{ :check5 :ok true . }
  pe:rule 24;
  pe:uses
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.

{ :check5 :msg "Check 5: for all trips that the reference world W0 marks as risky, at least one other world also flags risk; there are no examples where W0 is the only model to predict trouble." . }
  pe:rule 24;
  pe:uses
    { :HighwayLongCold :riskyInWorld :W0 . },
    { :HighwayLongCold :riskyInWorld :W2 . },
    { :HighwayLongCold :riskyInWorld :W3 . },
    { :ColdHighwayMidBattery :riskyInWorld :W0 . },
    { :ColdHighwayMidBattery :riskyInWorld :W3 . }.
