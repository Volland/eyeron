    [ pe:var "E0"; pe:value 0.4835555555555555 ],
    [ pe:var "T"; pe:value :CityShort ];
  pe:uses
    { :CityShort :energyRequired_W0 0.4835555555555555 . },
    { :CityShort :batteryKWh 40.0 . },
    { 0.4835555555555555 math:notGreaterThan 40.0 . }.

