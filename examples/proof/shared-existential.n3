{ :bob :loves _:__q1 . }
  pe:rule
    {
        @forSome <urn:eyeron:quantified:5f5f7131> .
        {
            @forAll <urn:eyeron:quantified:5f5f6261636b776172645f305f335f636266623564336633363231386432315f5f5f5f7132> .
            <urn:eyeron:quantified:5f5f6261636b776172645f305f335f636266623564336633363231386432315f5f5f5f7132> :loves <urn:eyeron:quantified:5f5f7131> .
        } <= true .
    }.

{ :liz :beloved _:__q1 . }
