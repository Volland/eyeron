# Matching people by a declared key
#
# People have given names and birth dates, and those properties form a
# declared key. An N3 rule uses a scoped universal test to identify
# matching key values and derive equality.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:Person owl:hasKey (:givenName :birthDate) .
:alice a :Person ;
    :givenName "Alice" ;
    :birthDate "1990-01-02" .
:alias a :Person ;
    :givenName "Alice" ;
    :birthDate "1990-01-02" .
:other a :Person ;
    :givenName "Alice" ;
    :birthDate "1991-03-04" .

# Inference rules
{
    ?C owl:hasKey ?L .
    ?X a ?C .
    ?Y a ?C .
    ?X log:notEqualTo ?Y .
    (
        {
            ?P list:in ?L
        }
        {
            ?X ?P ?Z .
            ?Y ?P ?Z
        }
    ) log:forAllIn ?SCOPE
} => {
    ?X owl:sameAs ?Y
} .
