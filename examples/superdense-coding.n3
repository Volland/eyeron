# Modeling superdense coding and teleportation
#
# Boolean relations provide a finite representation of quantum
# communication protocols. N3 rules compose these relations to derive the
# supplied superdense-coding and teleportation results.
#
# See <https://arxiv.org/pdf/1101.3764.pdf>
# See <https://arxiv.org/pdf/1010.2929.pdf>

@prefix dqc: <https://eyereasoner.github.io/eye/reasoning/dqc#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# |R) = |0, 0) + |1, 1)
false dqc:r false .
true dqc:r true .

# |S) = |0, 1) + |1, 0)
false dqc:s true .
true dqc:s false .

# |U) = |0, 0) + |1, 0) + |1, 1)
false dqc:u false .
true dqc:u false .
true dqc:u true .

# |V ) = |0, 0) + |0, 1) + |1, 0)
false dqc:v false .
false dqc:v true .
true dqc:v false .

# 1 |0) = |0)
false dqc:id false .

# 1 |1) = |1)
true dqc:id true .

# G |0) = |1)
false dqc:g true .

# G |1) = |0)
true dqc:g false .

# K |0) = |0)
false dqc:k false .

# K |1) = |0) + |1)
true dqc:k false .
true dqc:k true .

# KG
{
    ?X dqc:kg ?Y
} <= {
    ?X dqc:g ?Z .
    ?Z dqc:k ?Y .
} .

# GK
{
    ?X dqc:gk ?Y
} <= {
    ?X dqc:k ?Z .
    ?Z dqc:g ?Y .
} .

# Superdense coding
{
    ?N dqc:sdcoding ?M
} <= {
    ?X dqc:r ?Y .
    ?N dqc:alice (?X ?B) .
    (?B ?Y) dqc:bob ?M .
} .

# Alice
{
    0 dqc:alice (?X ?Y)
} <= {
    ?X dqc:id ?Y .
} .

{
    1 dqc:alice (?X ?Y)
} <= {
    ?X dqc:g ?Y .
} .

{
    2 dqc:alice (?X ?Y)
} <= {
    ?X dqc:k ?Y .
} .

{
    3 dqc:alice (?X ?Y)
} <= {
    ?X dqc:kg ?Y .
} .

# Bob
{
    (?S1 ?S2) dqc:bob 0
} <= {
    ?S1 dqc:gk ?S2 .
} .

{
    (?S1 ?S2) dqc:bob 1
} <= {
    ?S1 dqc:k ?S2 .
} .

{
    (?S1 ?S2) dqc:bob 2
} <= {
    ?S1 dqc:g ?S2 .
} .

{
    (?S1 ?S2) dqc:bob 3
} <= {
    ?S1 dqc:id ?S2 .
} .

# remove answers that appear an even number of times
{
    ?X dqc:sdcoding ?Y .
    (
        1 {
            ?X dqc:sdcoding ?Y
        }
        ?A
    ) log:collectAllIn ?SCOPE .
    ?A math:sum ?B .
    (?B 2) math:remainder 1 .
} => {
    ?X dqc:superdense-coding ?Y .
} .
