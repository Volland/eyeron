# Auditing a quoted theory's rules
#
# A quoted theory contains forward and backward rules together with facts.
# N3 graph patterns inspect the rules and test which bodies are supported,
# producing an audit of the selected theory.

@prefix : <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

<> :theory {

    # Bidirectional pair
    {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } => {
        ?X a ?D .
    } .

    {
        ?X a ?D .
    } <= {
        ?X a ?C .
        ?C rdfs:subClassOf ?D .
    } .

    # Forward-only rule
    {
        ?P :parentOf ?Q .
    } => {
        ?Q :childOf ?P .
    } .

    # Backward-only rule
    {
        ?P :worksFor ?Org .
    } <= {
        ?Org :employs ?P .
    } .

    # Facts that activate all three bodies
    :alice a :Student .
    :Student rdfs:subClassOf :Person .

    :alice :parentOf :bob .

    :acme :employs :carol .
} .

# Audit the quoted theory for forward/backward pairs
{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :ruleStatus :Bidirectional .
    ?B :ruleHead ?H .
} .

{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:notIncludes {
        ?H log:impliedBy ?B
    } .
} => {
    ?B :ruleStatus :ForwardOnly .
    ?B :ruleHead ?H .
} .

{
    ?W :theory ?F .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
    ?F log:notIncludes {
        ?B log:implies ?H
    } .
} => {
    ?B :ruleStatus :BackwardOnly .
    ?B :ruleHead ?H .
} .

# Check which rule bodies are active now
{
    ?W :theory ?F .
    ?F log:includes {
        ?B log:implies ?H
    } .
    ?F log:includes ?B .
} => {
    ?B :activeAs :ForwardBody .
} .

{
    ?W :theory ?F .
    ?F log:includes {
        ?H log:impliedBy ?B
    } .
    ?F log:includes ?B .
} => {
    ?B :activeAs :BackwardBody .
} .
