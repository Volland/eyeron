#!/usr/bin/env bash

# Run the release suite with live output and one final count of individual tests.
# Conformance cases replace their harness checks; W3C cases are counted once.
# Keep colours through tee for Cargo, libtest, and the custom harnesses.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

log=$(mktemp)
trap 'rm -f "$log"' EXIT

started=$(date +%s.%N)
CARGO_TERM_COLOR=always cargo test --release --color always "$@" -- --color always 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
elapsed=$(awk -v s="$started" -v e="$(date +%s.%N)" 'BEGIN { printf "%.2f", e - s }')

# Each suite reports its own result. Expand suites that also report individual
# conformance counts, rather than adding both the cases and their wrappers.
totals=$(sed -E 's/\x1b\[[0-9;]*m//g' "$log" | awk '
  /^w3c cases: / {
    cases_run += $3
    cases_ok += $5
    expanded = 1
  }
  /notation3tests score: / {
    score = $0
    sub(/^.*\(/, "", score)
    split(score, counts, /[\/)]/)
    cases_ok += counts[1]
    cases_run += counts[2]
    expanded = 1
  }
  /^[A-Za-z0-9_]+ result: / {
    passed = failed = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "passed;") passed = $(i - 1)
      if ($i == "failed;") failed = $(i - 1)
    }
    if (expanded) {
      run += cases_run
      ok += cases_ok
    } else {
      run += passed + failed
      ok += passed
    }
    cases_run = cases_ok = expanded = 0
  }
  END { printf "%d %.1f", run, run ? 100 * ok / run : 0 }
')
read -r run percent_ok <<< "$totals"

printf '\nTests: %s run; %s%% OK; %ss total' "$run" "$percent_ok" "$elapsed"
if [[ "$status" -ne 0 ]]; then
  printf ' (FAILED)'
fi
printf '\n'

exit "$status"
